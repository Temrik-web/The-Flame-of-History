    \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0430 \u0430\u0440\u043C\u0438\u0439
    \xAB\u0426\u0435\u043D\u0442\u0440\xBB \u043F\u043E\u0442\u0435\u0440\u043F\u0435\u043B\u0430
    \u043F\u043E\u043B\u043D\u043E\u0435 \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435.
    \u0412 \u0445\u043E\u0434\u0435 \u0432\u0442\u043E\u0440\u043E\u0433\u043E \u044D\u0442\u0430\u043F\u0430
    \u0411\u0435\u043B\u043E\u0440\u0443\u0441\u0441\u043A\u043E\u0439 \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0438
    \u0432 \u0438\u044E\u043B\u0435 1944 \u0433\u043E\u0434\u0430 \u0431\u044B\u043B\u0438
    \u043E\u0441\u0432\u043E\u0431\u043E\u0436\u0434\u0435\u043D\u044B \u041C\u043E\u043B\u043E\u0434\u0435\u0447\u043D\u043E,
    \u0421\u043C\u043E\u0440\u0433\u043E\u043D\u044C, \u0411\u0430\u0440\u0430\u043D\u043E\u0432\u0438\u0447\u0438,
    \u041D\u043E\u0432\u043E\u0433\u0440\u0443\u0434\u043E\u043A, \u041F\u0438\u043D\u0441\u043A,
    \u0413\u0440\u043E\u0434\u043D\u043E. \u0410 \u043E\u0441\u0432\u043E\u0431\u043E\u0436\u0434\u0435\u043D\u0438\u0435\u043C
    28 \u0438\u044E\u043B\u044F \u0411\u0440\u0435\u0441\u0442\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043B\u043E\u0441\u044C
    \u0438\u0437\u0433\u043D\u0430\u043D\u0438\u0435 \u043D\u0435\u043C\u0435\u0446\u043A\u043E-\u0444\u0430\u0448\u0438\u0441\u0442\u0441\u043A\u0438\u0445
    \u0437\u0430\u0445\u0432\u0430\u0442\u0447\u0438\u043A\u043E\u0432 \u0441 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438
    \u0411\u0435\u043B\u0430\u0440\u0443\u0441\u0438. "
