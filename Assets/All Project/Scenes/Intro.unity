    \u041A\u0430\u0440\u0435\u043B\u044C\u0441\u043A\u043E\u0433\u043E \u043F\u0435\u0440\u0435\u0448\u0435\u0439\u043A\u0430
    \u0432\u043E\u0439\u0441\u043A\u0430\u043C\u0438 \u041B\u0435\u043D\u0438\u043D\u0433\u0440\u0430\u0434\u0441\u043A\u043E\u0433\u043E
    \u0444\u0440\u043E\u043D\u0442\u0430 \u0438 \u0411\u0430\u043B\u0442\u0438\u0439\u0441\u043A\u043E\u0433\u043E
    \u0444\u043B\u043E\u0442\u0430, \u0430 \u0437\u0430\u0442\u0435\u043C \u2013
    \u0432\u043E \u0432\u0442\u043E\u0440\u043E\u0439 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0435
    \u0438\u044E\u043D\u044F \u2013 \u0432 \u0411\u0435\u043B\u0430\u0440\u0443\u0441\u0438.
    \u0413\u043B\u0430\u0432\u043D\u0430\u044F \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u044C
    \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E \u043D\u0430\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u044F
    \u0432\u043E\u0439\u0441\u043A, \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
    1-\u0433\u043E \u0411\u0435\u043B\u043E\u0440\u0443\u0441\u0441\u043A\u043E\u0433\u043E
    \u0444\u0440\u043E\u043D\u0442\u0430, \u0437\u0430\u043A\u043B\u044E\u0447\u0430\u043B\u0430\u0441\u044C
    \u0432 \u0442\u043E\u043C, \u0447\u0442\u043E \u0438\u043C \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u044F\u043B\u043E
    \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C \u0432 \u0442\u0440\u0443\u0434\u043D\u043E\u043F\u0440\u0435\u043E\u0434\u043E\u043B\u0438\u043C\u043E\u0439
