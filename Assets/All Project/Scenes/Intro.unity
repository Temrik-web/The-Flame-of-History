    \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0430\u044F \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0430.
    3 \u0438\u044E\u043B\u044F 1944 \u0433\u043E\u0434\u0430 \u0442\u0430\u043D\u043A\u0438\u0441\u0442\u044B
