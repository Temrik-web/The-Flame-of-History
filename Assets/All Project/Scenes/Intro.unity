    1 \u0438\u044E\u043B\u044F \u0432\u043E\u0439\u0441\u043A\u0430 3-\u0433\u043E
    \u0411\u0435\u043B\u043E\u0440\u0443\u0441\u0441\u043A\u043E\u0433\u043E \u0444\u0440\u043E\u043D\u0442\u0430
    \u043E\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u043B\u0438 \u0411\u043E\u0440\u0438\u0441\u043E\u0432.
    \u0412 \u041C\u0438\u043D\u0441\u043A\u043E\u043C \xAB\u043A\u043E\u0442\u043B\u0435\xBB
    \u043D\u0430 \u0432\u043E\u0441\u0442\u043E\u043A\u0435 \u043E\u0442 \u0441\u0442\u043E\u043B\u0438\u0446\u044B
