    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439 \u2013 \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0435\u0439
    \u0433\u0440\u0443\u043F\u043F\u044B \u0444\u0440\u043E\u043D\u0442\u043E\u0432,
    \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0435\u043D\u043D\u044B\u0445 \u0435\u0434\u0438\u043D\u044B\u043C
    \u0437\u0430\u043C\u044B\u0441\u043B\u043E\u043C \u0438 \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0438\u043C\u044B\u0445
    \u0412\u0435\u0440\u0445\u043E\u0432\u043D\u044B\u043C \u0433\u043B\u0430\u0432\u043D\u043E\u043A\u043E\u043C\u0430\u043D\u0434\u043E\u0432\u0430\u043D\u0438\u0435\u043C.
    \u041F\u043E \u043F\u043B\u0430\u043D\u0443 \u043B\u0435\u0442\u043D\u0435\u0439
    \u043A\u0430\u043C\u043F\u0430\u043D\u0438\u0438 1944 \u0433\u043E\u0434\u0430,
    \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u043B\u043E\u0441\u044C
    \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u0442\u044C \u043D\u0430\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u0435
