    5 \u0434\u0438\u0432\u0438\u0437\u0438\u0439. 27 \u0438\u044E\u043D\u044F \u0441\u043E\u0432\u0435\u0442\u0441\u043A\u0438\u0435
    \u0432\u043E\u0439\u0441\u043A\u0430 \u043E\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u043B\u0438
    \u041E\u0440\u0448\u0443. 29 \u0438\u044E\u043D\u044F \u0432\u043E\u0439\u0441\u043A\u0430
    \u041A\u0440\u0430\u0441\u043D\u043E\u0439 \u0410\u0440\u043C\u0438\u0438 \u0440\u0430\u0437\u0433\u0440\u043E\u043C\u0438\u043B\u0438
    \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0443 \u0432\u0440\u0430\u0433\u0430,
    \u043E\u043A\u0440\u0443\u0436\u0435\u043D\u043D\u0443\u044E \u043F\u043E\u0434
